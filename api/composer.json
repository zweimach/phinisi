{
    "name": "phinisi/api",
    "type": "project",
    "description": "A book management app",
    "homepage": "http://github.com/zweimach/phinisi",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Ananda Umamil",
            "email": "zweimach@zweimach.org",
            "homepage": "https://zweimach.org"
        }
    ],
    "require": {
        "php": "^8.3",
        "doctrine/dbal": "^4.0",
        "doctrine/orm": "^3.0",
        "middlewares/trailing-slash": "^2.0",
        "monolog/monolog": "^3.3",
        "php-di/php-di": "^7.0",
        "robmorgan/phinx": "^0.16",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.11",
        "symfony/cache": "^7.1",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "jangregor/phpstan-prophecy": "^1.0",
        "lctrs/psalm-psr-container-plugin": "^1.10",
        "phpspec/prophecy": "^1.17",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^1.11",
        "phpstan/phpstan-deprecation-rules": "^1.1",
        "phpstan/phpstan-doctrine": "^1.5",
        "phpstan/phpstan-strict-rules": "^1.5",
        "phpunit/phpunit": "^10.5",
        "psalm/plugin-phpunit": "^0.19.0",
        "symplify/easy-coding-standard": "^12.0",
        "vimeo/psalm": "^5.12"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "format": "ecs --fix --quiet",
        "lint": "phpstan analyse --no-progress --quiet && ecs check --quiet",
        "check": "psalm --no-progress --output-format=compact",
        "start": "php -S localhost:8080 -t public",
        "test": "phpunit"
    }
}
